"""Require actual dependency imports and ordinary nested Python process semantics."""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

from fixture_value import VALUE
from portable_customer.core import installed_drivers, prepared_method


async def test_runtime_dependencies() -> None:
    assert prepared_method() == "GET"
    assert isinstance(installed_drivers(), list)
    assert VALUE == 42


def test_nested_python_inherits_environment(monkeypatch) -> None:
    monkeypatch.setenv("PORTABLE_INHERITED", "parent-added")
    result = subprocess.run(
        [sys.executable, "-c", "import os; print(os.environ['PORTABLE_INHERITED'])"],
        capture_output=True,
        text=True,
        check=True,
        timeout=30,
    )
    assert result.stdout.strip() == "parent-added"


def test_nested_python_honors_explicit_environment(monkeypatch) -> None:
    monkeypatch.setenv("PORTABLE_OVERRIDE", "parent")
    monkeypatch.setenv("PORTABLE_REMOVED", "parent-only")
    environment = dict(os.environ)
    environment.update(PORTABLE_ADDED="child-added", PORTABLE_OVERRIDE="child", HOME="/portable-child-home")
    del environment["PORTABLE_REMOVED"]
    script = (
        "import json,os; print(json.dumps([os.getenv(name) for name in "
        "('PORTABLE_ADDED','PORTABLE_OVERRIDE','PORTABLE_REMOVED','HOME')]))"
    )
    result = subprocess.run(
        [sys.executable, "-c", script],
        env=environment,
        capture_output=True,
        text=True,
        check=True,
        timeout=30,
    )
    assert json.loads(result.stdout) == ["child-added", "child", None, "/portable-child-home"]
    assert os.environ["PORTABLE_OVERRIDE"] == "parent"
    assert os.environ["PORTABLE_REMOVED"] == "parent-only"


def test_nested_python_accepts_minimal_environment(monkeypatch) -> None:
    monkeypatch.setenv("PORTABLE_REMOVED", "parent-only")
    result = subprocess.run(
        [
            sys.executable,
            "-c",
            "import json,os; print(json.dumps([os.getenv('PORTABLE_ADDED'),os.getenv('PORTABLE_REMOVED'),os.getenv('HOME')]))",
        ],
        env={"PORTABLE_ADDED": "minimal"},
        capture_output=True,
        text=True,
        check=True,
        timeout=30,
    )
    assert json.loads(result.stdout) == ["minimal", None, None]


def test_nested_python_empty_environment_keeps_attached_imports() -> None:
    source = Path(__file__).resolve().parents[1] / "src"
    script = (
        "import json,sys; sys.path.insert(0, sys.argv[1]); "
        "from portable_customer.core import installed_drivers, prepared_method; "
        "print(json.dumps([prepared_method(), isinstance(installed_drivers(), list)]))"
    )
    result = subprocess.run(
        [sys.executable, "-c", script, str(source)],
        env={},
        capture_output=True,
        text=True,
        check=True,
        timeout=30,
    )
    assert json.loads(result.stdout) == ["GET", True]


def test_nested_python_preserves_cwd_and_relative_files(tmp_path: Path) -> None:
    (tmp_path / "payload.txt").write_text("caller-data", encoding="utf-8")
    (tmp_path / "helper.py").write_text(
        "import json\nfrom pathlib import Path\n"
        "print(json.dumps([str(Path.cwd()), Path('payload.txt').read_text(encoding='utf-8')]))\n",
        encoding="utf-8",
    )
    result = subprocess.run(
        [sys.executable, "helper.py"],
        cwd=tmp_path,
        capture_output=True,
        text=True,
        check=True,
        timeout=30,
    )
    assert json.loads(result.stdout) == [str(tmp_path.resolve()), "caller-data"]


def test_nested_python_shares_caller_owned_temporary_file() -> None:
    for directory in (None, "/tmp"):
        with tempfile.NamedTemporaryFile(mode="w+", encoding="utf-8", dir=directory) as stream:
            stream.write("parent-data")
            stream.flush()
            script = (
                "import sys; from pathlib import Path; path=Path(sys.argv[1]); "
                "assert path.read_text(encoding='utf-8') == 'parent-data'; "
                "path.write_text('child-data', encoding='utf-8')"
            )
            subprocess.run([sys.executable, "-c", script, stream.name], check=True, timeout=30)
            stream.seek(0)
            assert stream.read() == "child-data"
