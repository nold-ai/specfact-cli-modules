(version 1)
(deny default)
(deny process-fork)
(deny network*)
(if (equal? (param "ACQUISITION") "1")
  (begin
    (allow network-outbound
      (remote ip "*:443")
      (control-name "com.apple.netsrc")
      (literal "/private/var/run/mDNSResponder"))
    (allow mach-lookup
      (global-name "com.apple.mDNSResponder")
      (global-name "com.apple.SystemConfiguration.configd")
      (global-name "com.apple.SystemConfiguration.DNSConfiguration")
      (global-name "com.apple.system.opendirectoryd.libinfo"))
    (allow file-read-metadata
      (literal "/etc") (literal "/private") (literal "/private/etc")
      (literal "/var") (literal "/var/run") (literal "/private/var") (literal "/private/var/run"))
    (allow file-read*
      (literal "/etc/hosts") (literal "/private/etc/hosts")
      (literal "/etc/resolv.conf") (literal "/private/etc/resolv.conf")
      (literal "/var/run/resolv.conf") (literal "/private/var/run/resolv.conf"))))
(deny mach-task-exception-port-set)
(allow signal (target self))
(allow sysctl-read
  (sysctl-name "kern.ostype")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.version")
  (sysctl-name "kern.hostname")
  (sysctl-name "hw.machine")
  (sysctl-name "hw.pagesize")
  (sysctl-name "hw.pagesize_compat")
  (sysctl-name "hw.ncpu")
  (sysctl-name "hw.activecpu")
  (sysctl-name "hw.logicalcpu")
  (sysctl-name "hw.physicalcpu"))
(allow file-read* (literal "/"))
(allow file-read* file-write* (literal "/dev/null"))
(allow file-read* file-map-executable (subpath "/System/Library"))
(allow file-read* file-map-executable (subpath "/usr/lib"))
(allow file-read* file-map-executable (subpath "/System/Cryptexes/OS/System/Library"))
(allow file-read* file-map-executable (subpath "/System/Cryptexes/OS/usr/lib"))
(allow file-read* file-map-executable (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library"))
(allow file-read* file-map-executable (subpath "/System/Volumes/Preboot/Cryptexes/OS/usr/lib"))
(allow file-read-metadata
  (literal "/System")
  (literal "/usr")
  (literal "/System/Cryptexes")
  (literal "/System/Cryptexes/OS")
  (literal "/System/Cryptexes/OS/System")
  (literal "/System/Cryptexes/OS/usr")
  (literal "/System/Volumes")
  (literal "/System/Volumes/Preboot")
  (literal "/System/Volumes/Preboot/Cryptexes")
  (literal "/System/Volumes/Preboot/Cryptexes/OS")
  (literal "/System/Volumes/Preboot/Cryptexes/OS/System")
  (literal "/System/Volumes/Preboot/Cryptexes/OS/usr"))
(allow file-read-metadata
  (literal (param "ANCESTOR0")) (literal (param "ANCESTOR1"))
  (literal (param "ANCESTOR2")) (literal (param "ANCESTOR3"))
  (literal (param "ANCESTOR4")) (literal (param "ANCESTOR5"))
  (literal (param "ANCESTOR6")) (literal (param "ANCESTOR7"))
  (literal (param "ANCESTOR8")) (literal (param "ANCESTOR9"))
  (literal (param "ANCESTOR10")) (literal (param "ANCESTOR11"))
  (literal (param "ANCESTOR12")) (literal (param "ANCESTOR13"))
  (literal (param "ANCESTOR14")) (literal (param "ANCESTOR15")))
(allow file-read-metadata (literal (param "INVOCATION")))
(allow file-read* (subpath (param "CAPSULE")))
(allow file-read* (subpath (param "PROJECT")))
(allow file-read* (subpath (param "OUTPUT")))
(allow file-read* (subpath (param "TEMPORARY")))
(allow file-write* (subpath (param "OUTPUT")))
(allow file-write* (subpath (param "TEMPORARY")))
(allow file-read* file-map-executable process-exec (literal (param "PYTHON")))
(allow file-read* file-map-executable process-exec (literal (param "TOOL")))
